# Gocompliances CRM Frontend Environment Configuration
# Recommended for local development and production: Leave empty or unset to use relative '/api'
# In local development, Vite proxies '/api' -> 'http://127.0.0.1:8000' (no CORS or IPv6 issues).
VITE_API_BASE_URL=
# Or specify an explicit backend origin if running across separate external servers:
# VITE_API_BASE_URL=http://127.0.0.1:8000
