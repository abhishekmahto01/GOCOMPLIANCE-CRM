# ==============================================================================
# Gocompliances CRM - Backend Environment Variables Template
# Copy this file to .env and adjust values for your local development setup.
# ==============================================================================

# Application Settings
PROJECT_NAME="Gocompliances CRM API"
ADMIN_PROJECT_NAME="Gocompliances Database Admin"
ENVIRONMENT="development"
VERSION="0.1.0"

# Server Network Configuration
API_HOST="0.0.0.0"
API_PORT=8000
ADMIN_PORT=8001

# CORS Configuration (comma-separated or single URL)
FRONTEND_ORIGIN="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# Database Configuration (PostgreSQL with psycopg3 driver)
#
# Format with password:
# DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/is_gocompliance_db
#
# Format without password (peer/local trust authentication):
# DATABASE_URL=postgresql+psycopg://YOUR_USERNAME@localhost:5432/is_gocompliance_db
DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/is_gocompliance_db

# Security & JWT Authentication (Stage 7B)
# Generate a secure key using: openssl rand -base64 48 or python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="YOUR_SECURE_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ==============================================================================
# Isolated Test Database Configuration (PostgreSQL with psycopg3 driver)
# ==============================================================================
# Automated tests require a dedicated test database (e.g. is_gocompliance_test_db).
# Tests will NEVER run against the development database.
# Create the test database before running tests:
#   createdb is_gocompliance_test_db
#
# Format:
# TEST_DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/is_gocompliance_test_db
TEST_DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/is_gocompliance_test_db

# ==============================================================================
# Trial Phase Credentials Provisioning (STAGE B: LOCAL TESTING / TRIAL ONLY)
# ==============================================================================
# WARNING: Trial default password provisioning is for local development only.
# It is strictly refused when ENVIRONMENT=production or APP_ENV=production.
# For production deployment, set TRIAL_DEFAULT_PASSWORD_ENABLED=false.
# In local development, specify your temporary testing password below (e.g., 12345).
TRIAL_DEFAULT_PASSWORD_ENABLED=false
TRIAL_DEFAULT_PASSWORD=""

